    "configuration": {
      "title": "Flash",
      "properties": {
        "flash.labels": {
          "type": "string",
          "default": "asdfghjklqwertyuiopzxcvbnm",
          "description": "Keys used for jump labels in order of priority (home row first)."
        },
        "flash.search.mode": {
          "type": "string",
          "enum": [
            "exact",
            "fuzzy",
            "regex"
          ],
          "default": "exact",
          "description": "Matching mode: exact, fuzzy, or regular expression."
        },
        "flash.search.multiWindow": {
          "type": "boolean",
          "default": true,
          "description": "Search and display jump labels across all visible editor panes."
        },
        "flash.search.smartCase": {
          "type": "boolean",
          "default": true,
          "description": "Case-insensitive if pattern is lowercase; case-sensitive if pattern has uppercase."
        },
        "flash.search.maxMatchCount": {
          "type": "number",
          "default": 300,
          "description": "Maximum number of visible matches to process for performance."
        },
        "flash.label.uppercase": {
          "type": "boolean",
          "default": true,
          "description": "Allow uppercase labels when candidate matches exceed lowercase labels."
        },
        "flash.label.reuse": {
          "type": "string",
          "enum": [
            "lowercase",
            "all",
            "none"
          ],
          "default": "lowercase",
          "description": "Reuse assigned labels across subsequent keystrokes to prevent label flickering."
        },
        "flash.label.distanceSort": {
          "type": "boolean",
          "default": true,
          "description": "Sort candidate matches by distance from cursor to give closer targets higher priority labels."
        },
        "flash.label.style": {
          "type": "string",
          "enum": [
            "overlay",
            "after",
            "before"
          ],
          "default": "overlay",
          "description": "Position style of jump labels relative to matched characters."
        },
        "flash.label.minPatternLength": {
          "type": "number",
          "default": 0,
          "description": "Minimum pattern length required before showing jump labels (0 shows labels from 1st char)."
        },
        "flash.highlight.backdrop": {
          "type": "boolean",
          "default": true,
          "description": "Dim / fade out non-matching text to make search targets and labels pop."
        },
        "flash.highlight.labelBackgroundColor": {
          "type": "string",
          "default": "#ff007c",
          "description": "Background color for jump labels (Folke's iconic magenta badge)."
        },
        "flash.highlight.labelForegroundColor": {
          "type": "string",
          "default": "#ffffff",
          "description": "Foreground text color for jump labels."
        },
        "flash.highlight.matchBackgroundColor": {
          "type": "string",
          "default": "rgba(62, 104, 215, 0.35)",
          "description": "Highlight background color for search matches."
        },
        "flash.highlight.currentMatchBackgroundColor": {
          "type": "string",
          "default": "rgba(255, 150, 108, 0.50)",
          "description": "Highlight background color for current / active match."
        },
        "flash.charMotion.multiLine": {
          "type": "boolean",
          "default": true,
          "description": "Allow f/t/F/T motions to search across visible lines instead of current line only."
        },
        "flash.jump.autojump": {
          "type": "boolean",
          "default": false,
          "description": "Automatically jump when there is only one match remaining."
        },
        "flash.inputMode": {
          "type": "string",
          "enum": [
            "inEditor",
            "quickInput"
          ],
          "default": "inEditor",
          "description": "Input capture mode: \"inEditor\" captures keystrokes directly in editor without hijacking the global type command; \"quickInput\" uses a floating QuickInput box."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node ./dist/test/runUnitTests.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.80.0",
    "mocha": "^10.3.0",
    "typescript": "^5.3.3"
  }
}
