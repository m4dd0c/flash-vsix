{
  "name": "flash-vim",
  "displayName": "Flash for VS Code & Cursor & Antigravity",
  "description": "Navigate your code with search labels, enhanced character motions, and AST Treesitter integration. Port of folke/flash.nvim.",
  "version": "1.0.0",
  "publisher": "folke-flash",
  "repository": {
    "type": "git",
    "url": "https://github.com/folke/flash.nvim"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Keymaps",
    "Other"
  ],
  "keywords": [
    "flash",
    "jump",
    "motion",
    "easymotion",
    "hop",
    "leap",
    "vim",
    "neovim",
    "navigation"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "flash.jump",
        "title": "Flash: Jump",
        "category": "Flash"
      },
      {
        "command": "flash.jumpSelect",
        "title": "Flash: Jump and Select",
        "category": "Flash"
      },
      {
        "command": "flash.treesitter",
        "title": "Flash: Treesitter AST Node Selection",
        "category": "Flash"
      },
      {
        "command": "flash.treesitterSearch",
        "title": "Flash: Treesitter Search and Select AST Node",
        "category": "Flash"
      },
      {
        "command": "flash.jumpWord",
        "title": "Flash: Jump to Word",
        "category": "Flash"
      },
      {
        "command": "flash.jumpLine",
        "title": "Flash: Jump to Line",
        "category": "Flash"
      },
      {
        "command": "flash.findNextChar",
        "title": "Flash: Find Next Char (f)",
        "category": "Flash"
      },
      {
        "command": "flash.findPrevChar",
        "title": "Flash: Find Prev Char (F)",
        "category": "Flash"
      },
      {
        "command": "flash.tillNextChar",
        "title": "Flash: Till Next Char (t)",
        "category": "Flash"
      },
      {
        "command": "flash.tillPrevChar",
        "title": "Flash: Till Prev Char (T)",
        "category": "Flash"
      },
      {
        "command": "flash.repeat",
        "title": "Flash: Repeat Last Motion",
        "category": "Flash"
      },
      {
        "command": "flash.cancel",
        "title": "Flash: Cancel",
        "category": "Flash"
      },
      {
        "command": "flash.backspace",
        "title": "Flash: Backspace Query",
        "category": "Flash"
      },
      {
        "command": "flash.jumpFirst",
        "title": "Flash: Jump to First / Current Match",
        "category": "Flash"
      },
      {
        "command": "flash.nextMatch",
        "title": "Flash: Next Match",
        "category": "Flash"
      },
      {
        "command": "flash.prevMatch",
        "title": "Flash: Previous Match",
        "category": "Flash"
      },
      {
        "command": "flash.toggleMode",
        "title": "Flash: Toggle Match Mode (exact/fuzzy/regex)",
        "category": "Flash"
      },
      {
        "command": "flash.inputKey",
        "title": "Flash: Input Key",
        "category": "Flash"
      }
    ],
    "keybindings": [
      {
        "command": "flash.jump",
        "key": "cmd+alt+s",
        "mac": "cmd+alt+s",
        "when": "editorTextFocus && !flash.active"
      },
      {
        "command": "flash.treesitter",
        "key": "cmd+alt+t",
        "mac": "cmd+alt+t",
        "when": "editorTextFocus && !flash.active"
      },
      {
        "command": "flash.jumpWord",
        "key": "cmd+alt+w",
        "mac": "cmd+alt+w",
        "when": "editorTextFocus && !flash.active"
      },
      {
        "command": "flash.jump",
        "key": "alt+s",
        "mac": "alt+s",
        "when": "editorTextFocus && !flash.active"
      },
      {
        "command": "flash.jumpSelect",
        "key": "alt+shift+s",
        "mac": "alt+shift+s",
        "when": "editorTextFocus && !flash.active"
      },
      {
        "command": "flash.treesitter",
        "key": "alt+t",
        "mac": "alt+t",
        "when": "editorTextFocus && !flash.active"
      },
      {
        "command": "flash.jumpWord",
        "key": "alt+w",
        "mac": "alt+w",
        "when": "editorTextFocus && !flash.active"
      },
      {
        "command": "flash.jumpLine",
        "key": "alt+l",
        "mac": "alt+l",
        "when": "editorTextFocus && !flash.active"
      },
      {
        "command": "flash.cancel",
        "key": "escape",
        "when": "flash.active"
      },
      {
        "command": "flash.backspace",
